{
	"name": "lottery-picker",
	"private": true,
	"version": "0.1.0",
	"description": "Hot, cold and overdue number analysis for Canadian lottery draws.",
	"author": "Sasha Chernyavsky",
	"license": "PolyForm-Noncommercial-1.0.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Astreys/lottery-picker.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"images": "node scripts/make-images.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.4.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@netlify/blobs": "^11.0.3"
	}
}
