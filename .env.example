# Google Analytics 4 measurement ID. Leave unset to run without analytics —
# nothing is loaded and no requests are made to Google.
# Locally: copy this file to .env and fill it in.
# On Netlify: Site configuration -> Environment variables.
PUBLIC_GA_ID=G-QHYK04J3YY

# Nothing else is required. Netlify Blobs is provisioned automatically on
# deploy, and local dev falls back to an in-memory cache.
